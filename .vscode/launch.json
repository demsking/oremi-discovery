{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current Python File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Debug",
      "type": "python",
      "request": "launch",
      "module": "oremi-discovery",
      "args": [
        "--verbose",
        "--host", "0.0.0.0"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
